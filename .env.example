# ============================================
# HidroScanner — Environment Variables
# ============================================

# ── Supabase ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── App Config ─────────────────────────────
APP_NAME=HidroScanner
APP_ENV=development
APP_VERSION=1.0.0

# ── Frontend Config (injected into JS) ─────
# Set these in frontend/js/api.js or load dynamically
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key

# ── GeoServer (optional) ──────────────────
GEOSERVER_URL=http://localhost:8181/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASS=geoserver

# ── Email Alerts (optional) ────────────────
ALERT_EMAIL_FROM=hidroscanner@agrageo.com.br
ALERT_EMAIL_TO=alexagra.contato@gmail.com
RESEND_API_KEY=
